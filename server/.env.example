# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cyber_safety_db

# External Threat Intelligence Configuration (Google Web Risk)
# Official Docs: https://docs.cloud.google.com/web-risk/docs/lookup-api
GOOGLE_WEB_RISK_API_KEY=your_google_web_risk_api_key_here

# Security & Secrets (Placeholders only)
JWT_SECRET=your_jwt_secret_key_here
API_KEY_SECRET=your_api_key_secret_here
