{
  "manifest_version": 3,
  "name": "Cyber Safety Protection Engine",
  "version": "1.1.0",
  "description": "Real-time background threat evaluation and domain security lookup for active browser tabs.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://cyber-safety-platform-50px.onrender.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cyber Safety Protection"
  }
}
