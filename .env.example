# Cyber Safety Platform — Production Environment Variables Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT REPOSITORIES

# ==========================================
# 1. SERVER REQUIRED CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cyber_safety_db?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=24h
CORS_ORIGIN=https://dashboard.cybersafety.org

# ==========================================
# 2. OPTIONAL EXTERNAL INTEGRATION KEYS
# (Graceful fallbacks active when unconfigured)
# ==========================================
GOOGLE_WEB_RISK_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ==========================================
# 3. FRONTEND REQUIRED BUILD CONFIGURATION
# (Used at Vite compile time in client/.env)
# ==========================================
VITE_API_BASE_URL=https://api.cybersafety.org
